datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  GUEST
  USER
  ADMIN
}

enum SubscriptionTier {
  FREE
  VIP
  PRO
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum PostVisibility {
  PUBLIC
  CONNECTIONS
  SELECTED
  PRIVATE
}

enum CommentStatus {
  APPROVED
  FLAGGED
  HIDDEN
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  passwordHash     String?
  role             Role             @default(USER)
  tier             SubscriptionTier @default(FREE)
  tierExpiresAt    DateTime?
  isVerified       Boolean          @default(false)
  isBanned         Boolean          @default(false)
  banReason        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  profile          Profile?
  settings         UserSetting?
  consents         UserConsent[]
  payments         Payment[]
  posts            Post[]
  comments         Comment[]
  moderationLogs   ModerationLog[]  @relation("AdminModerationLogs")
  reportsReported  Report[]         @relation("ReportReporter")
  reportsTargeted  Report[]         @relation("ReportTargetUser")
  connectionsFrom  Connection[]     @relation("UserConnections")
  connectionsTo    Connection[]     @relation("ConnectedUsers")

  @@index([role, tier, isBanned])
}

model Profile {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  username       String?   @unique
  avatarUrl      String?
  bio            String?
  gender         String?
  dateOfBirth    DateTime?
  location       String?
  interests      String[]  @default([])
  habits         String[]  @default([])
  connectionGoal String?
  updatedAt      DateTime  @updatedAt
}

model UserSetting {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileVisibility String   @default("PUBLIC")
  emailNotification Boolean  @default(true)
  language          String   @default("vi")
  theme             String   @default("light")
  updatedAt         DateTime @updatedAt
}

model Payment {
  id              String        @id @default(uuid())
  orderCode       Int           @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier            SubscriptionTier
  durationMonths  Int           @default(1)
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("VND")
  paymentMethod   String        @default("PAYOS")
  status          PaymentStatus @default(PENDING)
  checkoutUrl     String?
  transactionRef  String?
  paidAt          DateTime?
  rawWebhookData  Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId, status, orderCode])
}

model Post {
  id          String         @id @default(uuid())
  authorId    String
  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content     String
  mediaUrls   String[]       @default([])
  visibility  PostVisibility @default(PUBLIC)
  likesCount  Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  comments    Comment[]
  reports     Report[]

  @@index([visibility, createdAt])
}

model Comment {
  id          String        @id @default(uuid())
  postId      String
  post        Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId    String
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content     String
  status      CommentStatus @default(APPROVED)
  flagReason  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  reports     Report[]

  @@index([postId, status, createdAt])
}

model Report {
  id             String       @id @default(uuid())
  reporterId     String
  reporter       User         @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUserId   String?
  targetUser     User?        @relation("ReportTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  postId         String?
  post           Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId      String?
  comment        Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reason         String
  status         String       @default("PENDING")
  createdAt      DateTime     @default(now())
}

model ModerationLog {
  id           String    @id @default(uuid())
  adminId      String
  admin        User      @relation("AdminModerationLogs", fields: [adminId], references: [id], onDelete: Cascade)
  action       String
  targetType   String
  targetId     String
  note         String?
  createdAt    DateTime  @default(now())
}

model BadWord {
  id        String   @id @default(uuid())
  pattern   String   @unique
  category  String   @default("OFFENSIVE")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model UserConsent {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId    String?
  consentType  String
  isAccepted   Boolean  @default(true)
  acceptedAt   DateTime @default(now())
  ipAddress    String?
  userAgent    String?

  @@index([userId, sessionId, consentType])
}

model Connection {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation("UserConnections", fields: [userId], references: [id], onDelete: Cascade)
  targetId    String
  target      User     @relation("ConnectedUsers", fields: [targetId], references: [id], onDelete: Cascade)
  status      String   @default("ACCEPTED")
  createdAt   DateTime @default(now())

  @@unique([userId, targetId])
}
