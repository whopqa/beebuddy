  userId          String
  user            User                @relation("RestrictedUser", fields: [userId], references: [id], onDelete: Cascade)
  type            UserRestrictionType
  reasonCode      String
  note            String?
  featureCode     String?
  startsAt        DateTime            @default(now())
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdByUserId String?
  createdByUser   User?               @relation("RestrictionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  revokedByUserId String?
  revokedByUser   User?               @relation("RestrictionRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())

  @@index([userId, type, revokedAt, expiresAt])
  @@index([featureCode, revokedAt])
}

model ModerationLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation("AdminModerationLogs", fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  targetType String
  targetId   String
  note       String?
  createdAt  DateTime @default(now())
}

model BadWord {
  id        String   @id @default(uuid())
  pattern   String   @unique
  category  String   @default("OFFENSIVE")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model UserConsent {
  id                 String          @id @default(uuid())
  userId             String?
  user               User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId          String?
  anonymousSessionId String?
  legalDocumentId    String
  legalDocument      LegalDocument   @relation(fields: [legalDocumentId], references: [id], onDelete: Restrict)
  consentType        String
  isAccepted         Boolean         @default(true)
  decision           ConsentDecision @default(ACCEPTED)
  categories         Json?
  acceptedAt         DateTime        @default(now())
  consentedAt        DateTime        @default(now())
  ipAddress          String?
  userAgent          String?

  @@index([userId, sessionId, consentType])
  @@index([legalDocumentId, consentedAt])
  @@index([anonymousSessionId, consentedAt])
}

model LegalDocument {
  id          String            @id @default(uuid())
  type        LegalDocumentType
  version     String
  contentHash String
  publishedAt DateTime
  effectiveAt DateTime
  retiredAt   DateTime?
  createdAt   DateTime          @default(now())
  consents    UserConsent[]

  @@unique([type, version])
  @@index([type, effectiveAt, retiredAt])
}

model UserDataRequest {
  id              String                @id @default(uuid())
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  type            UserDataRequestType
  status          UserDataRequestStatus @default(REQUESTED)
  requestedAt     DateTime              @default(now())
  verifiedAt      DateTime?
  completedAt     DateTime?
  resultLocation  String?
  resultExpiresAt DateTime?
  rejectionReason String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([userId, status, requestedAt])
  @@index([status, requestedAt])
}

model Connection {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation("UserConnections", fields: [userId], references: [id], onDelete: Cascade)
  targetId    String
  target      User             @relation("ConnectedUsers", fields: [targetId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  pairKey     String           @unique
  status      ConnectionStatus @default(PENDING)
  requestedAt DateTime         @default(now())
  respondedAt DateTime?
  endedAt     DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, targetId])
  @@index([requesterId, status, requestedAt])
  @@index([addresseeId, status, requestedAt])
  @@index([status, updatedAt])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  reason    String?
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId, createdAt])
}
