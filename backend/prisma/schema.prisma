datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  GUEST
  USER
  ADMIN
}

enum SubscriptionTier {
  FREE
  VIP
  PRO
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PostVisibility {
  PUBLIC
  CONNECTIONS
  SELECTED
  CUSTOM
  PRIVATE
}

enum CommentStatus {
  PENDING
  APPROVED
  FLAGGED
  HIDDEN
  REMOVED
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

enum OneTimeTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ProfileSection {
  BASIC
  BIO
  AGE
  OCCUPATION
  INTERESTS
  HABITS
  PLACES
  GOALS
  INTRO_MEDIA
}

enum ProfileAudience {
  PUBLIC
  CONNECTIONS
  ONLY_ME
}

enum UserPlaceRelation {
  HOME
  CURRENT
  FREQUENT
  FAVORITE
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  REMOVED
}

enum CommentPolicy {
  EVERYONE
  CONNECTIONS
  MENTIONED
  DISABLED
}

enum MediaProcessingStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  DELETED
}

enum ReactionType {
  LIKE
  LOVE
  SUPPORT
  CELEBRATE
  CURIOUS
}

enum ShareDestination {
  PROFILE
  COMMUNITY
  EXTERNAL
}

enum BillingPeriod {
  NONE
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum SubscriptionSource {
  PAYOS
  IN_APP
  ADMIN
  PROMOTION
}

enum PaymentProvider {
  PAYOS
  GOOGLE_PLAY
  APPLE
  MANUAL
}

enum EntitlementSourceType {
  SUBSCRIPTION
  PROMOTION
  ADMIN
  BETA
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum ReportSource {
  USER
  RULE
  AI
  SYSTEM
}

enum ReportStatus {
  OPEN
  TRIAGED
  RESOLVED
  DISMISSED
}

enum ModerationCaseStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum ModerationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
  WORKER
}

enum UserRestrictionType {
  WARNING
  SUSPENSION
  BAN
  FEATURE_RESTRICTION
}

enum LegalDocumentType {
  TERMS
  PRIVACY
  COOKIE_POLICY
  MARKETING
}

enum ConsentDecision {
  ACCEPTED
  REJECTED
  CUSTOMIZED
  REVOKED
}

enum UserDataRequestType {
  EXPORT
  DELETE
  CORRECT
}

enum UserDataRequestStatus {
  REQUESTED
  VERIFIED
  PROCESSING
  COMPLETED
  REJECTED
}

enum CommunityVisibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum CommunityStatus {
  ACTIVE
  ARCHIVED
  SUSPENDED
  DELETED
}

enum CommunityJoinPolicy {
  OPEN
  APPROVAL
  INVITE_ONLY
}

enum CommunityMemberRole {
  OWNER
  MODERATOR
  MEMBER
}

enum CommunityMemberStatus {
  INVITED
  ACTIVE
  LEFT
  REMOVED
  BANNED
}

enum CommunityJoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum CommunityInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

enum ConversationType {
  DIRECT
  GROUP
  AI
}

enum ConversationMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum ConversationMemberStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum MessageSenderType {
  USER
  SYSTEM
  ASSISTANT
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  VOICE
  FILE
  SYSTEM
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  COMMUNITY_INVITE
  COMMUNITY_JOIN_APPROVED
  MESSAGE
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
}

enum PushPlatform {
  WEB
  IOS
  ANDROID
}

enum OutboxEventType {
  NOTIFICATION_CREATED
  PUSH_DISPATCH
  AI_MODERATION_REQUESTED
  ANALYTICS_EVENT_RECORDED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  DECLINED
  MISSED
  FAILED
}

enum CallParticipantRole {
  HOST
  PARTICIPANT
}

enum CallParticipantStatus {
  INVITED
  JOINED
  LEFT
  DECLINED
  MISSED
}

enum MatchRecommendationStatus {
  PENDING
  VIEWED
  ACCEPTED
  DISMISSED
  EXPIRED
}

enum MatchFeedbackType {
  LIKE
  PASS
  BLOCK
  REPORT
  CONNECT
}

enum MoodValue {
  VERY_LOW
  LOW
  NEUTRAL
  GOOD
  GREAT
}

enum HabitRoutineFrequency {
  DAILY
  WEEKLY
  CUSTOM
}

enum HabitCompletionSource {
  USER
  SYSTEM
  IMPORT
}

enum MascotSuggestionType {
  CHECK_IN
  HABIT
  SOCIAL
  CONTENT
}

enum MascotSuggestionStatus {
  PENDING
  SEEN
  ACCEPTED
  DISMISSED
  EXPIRED
}

enum MascotMemoryCategory {
  PREFERENCE
  GOAL
  WELLBEING
  CONTEXT
}

enum MascotMemorySourceType {
  USER_EXPLICIT
  CONVERSATION
  MOOD_CHECK_IN
  HABIT
}

enum AiExecutionStatus {
  SUCCESS
  FAILED
  BLOCKED
}

enum ModerationScanStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id            String           @id @default(uuid())
  email         String           @unique
  passwordHash  String?
  role          Role             @default(USER)
  tier          SubscriptionTier @default(FREE)
  tierExpiresAt DateTime?
  isVerified    Boolean          @default(false)
  isBanned      Boolean          @default(false)
  banReason     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  profile                   Profile?
  settings                  UserSetting?
  consents                  UserConsent[]
  payments                  Payment[]
  posts                     Post[]
  comments                  Comment[]
  moderationLogs            ModerationLog[]          @relation("AdminModerationLogs")
  reportsReported           Report[]                 @relation("ReportReporter")
  reportsTargeted           Report[]                 @relation("ReportTargetUser")
  connectionsFrom           Connection[]             @relation("UserConnections")
  connectionsTo             Connection[]             @relation("ConnectedUsers")
  requestsSent              Connection[]             @relation("ConnectionRequester")
  requestsReceived          Connection[]             @relation("ConnectionAddressee")
  following                 Follow[]                 @relation("Following")
  followers                 Follow[]                 @relation("Followers")
  blocksCreated             UserBlock[]              @relation("Blocker")
  blocksReceived            UserBlock[]              @relation("Blocked")
  authIdentities            AuthIdentity[]
  sessions                  UserSession[]
  oneTimeTokens             OneTimeToken[]
  userInterests             UserInterest[]
  userHabits                UserHabit[]
  userPlaces                UserPlace[]
  connectionGoals           UserConnectionGoal[]
  visibilityRules           ProfileVisibilityRule[]
  mediaAssets               MediaAsset[]
  postAudienceGrants        PostAudienceUser[]
  postExclusions            PostExcludedUser[]
  audienceLists             AudienceList[]
  audienceMemberships       AudienceListMember[]
  postReactions             PostReaction[]
  commentReactions          CommentReaction[]
  postBookmarks             PostBookmark[]
  postShares                PostShare[]
  subscriptions             Subscription[]
  entitlementGrants         EntitlementGrant[]
  moderationCasesAssigned   ModerationCase[]         @relation("ModerationAssignee")
  moderationDecisions       ModerationDecision[]
  auditLogsActed            AuditLog[]               @relation("AuditActor")
  restrictions              UserRestriction[]        @relation("RestrictedUser")
  restrictionsCreated       UserRestriction[]        @relation("RestrictionCreator")
  restrictionsRevoked       UserRestriction[]        @relation("RestrictionRevoker")
  dataRequests              UserDataRequest[]
  communitiesOwned          Community[]              @relation("CommunityOwner")
  communityMemberships      CommunityMember[]
  communityJoinRequests     CommunityJoinRequest[]   @relation("CommunityJoinRequester")
  communityRequestsReviewed CommunityJoinRequest[]   @relation("CommunityJoinReviewer")
  communityInvitesSent      CommunityInvite[]        @relation("CommunityInviter")
  communityInvitesReceived  CommunityInvite[]        @relation("CommunityInvitee")
  conversationsCreated      Conversation[]           @relation("ConversationCreator")
  conversationMemberships   ConversationMember[]
  messagesSent              Message[]                @relation("MessageSender")
  messageReactions          MessageReaction[]
  messageReadReceipts       MessageReadReceipt[]
  notificationsReceived     Notification[]           @relation("NotificationRecipient")
  notificationActors        Notification[]           @relation("NotificationActor")
  notificationPreferences   NotificationPreference[]
  devicePushTokens          DevicePushToken[]
  callsInitiated            CallSession[]            @relation("CallInitiator")
  callParticipations        CallParticipant[]
  matchingPreference        MatchingPreference?
  matchRecommendations      MatchRecommendation[]    @relation("MatchRecommendationOwner")
  recommendedToOthers       MatchRecommendation[]    @relation("MatchRecommendationCandidate")
  matchFeedbackGiven        MatchFeedback[]          @relation("MatchFeedbackOwner")
  matchFeedbackReceived     MatchFeedback[]          @relation("MatchFeedbackCandidate")
  moodCheckIns              MoodCheckIn[]
  habitRoutines             HabitRoutine[]
  habitCompletions          HabitCompletion[]
  mascotSuggestions         MascotSuggestion[]
  mascotMemories            MascotMemory[]
  aiExecutionLogs           AiExecutionLog[]
  analyticsEvents           AnalyticsEvent[]

  @@index([role, tier, isBanned])
}

model AuthIdentity {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        AuthProvider
  providerSubject String
  passwordHash    String?
  providerEmail   String?
  verifiedAt      DateTime?
  lastUsedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@index([userId])
}

model UserSession {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash    String    @unique
  deviceId            String?
  deviceName          String?
  platform            String?
  ipAddress           String?
  userAgent           String?
  lastUsedAt          DateTime  @default(now())
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedBySessionId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId, revokedAt, expiresAt])
}

model OneTimeToken {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         OneTimeTokenType
  tokenHash    String           @unique
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int              @default(0)
  createdAt    DateTime         @default(now())

  @@index([userId, type, consumedAt, expiresAt])
}

model Profile {
  id                    String           @id @default(uuid())
  userId                String           @unique
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName              String
  username              String?          @unique
  avatarUrl             String?
  bio                   String?
  aboutMe               String?
  personalityType       String?
  lifestyle             String?
  hobbies               String[]         @default([])
  skills                String[]         @default([])
  favoriteColors        String[]         @default([])
  socialLinks           String[]         @default([])
  galleryMediaIds       String[]         @default([])
  gender                String?
  dateOfBirth           DateTime?
  location              String?
  interests             String[]         @default([])
  habits                String[]         @default([])
  connectionGoal        String?
  occupation            String?
  industry              String?
  countryCode           String?
  onboardingStatus      OnboardingStatus @default(NOT_STARTED)
  onboardingCompletedAt DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model Interest {
  id             String         @id @default(uuid())
  slug           String         @unique
  displayName    String
  normalizedName String         @unique
  isActive       Boolean        @default(true)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  users          UserInterest[]

  @@index([isActive, sortOrder])
}

model UserInterest {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interestId  String
  interest    Interest @relation(fields: [interestId], references: [id], onDelete: Restrict)
  priority    Int      @default(0)
  proficiency String?
  source      String   @default("USER")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, interestId])
  @@index([interestId, userId])
}

model Habit {
  id             String         @id @default(uuid())
  slug           String         @unique
  displayName    String
  normalizedName String         @unique
  isActive       Boolean        @default(true)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  users          UserHabit[]
  routines       HabitRoutine[]

  @@index([isActive, sortOrder])
}

model UserHabit {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitId       String
  habit         Habit    @relation(fields: [habitId], references: [id], onDelete: Restrict)
  priority      Int      @default(0)
  frequency     String?
  preferredTime String?
  source        String   @default("USER")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, habitId])
  @@index([habitId, userId])
}

model Place {
  id             String      @id @default(uuid())
  slug           String      @unique
  displayName    String
  normalizedName String      @unique
  countryCode    String?
  regionCode     String?
  city           String?
  district       String?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  users          UserPlace[]

  @@index([countryCode, city, isActive])
}

model UserPlace {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId      String
  place        Place             @relation(fields: [placeId], references: [id], onDelete: Restrict)
  relationType UserPlaceRelation @default(CURRENT)
  isPrimary    Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([userId, placeId, relationType])
  @@index([placeId, userId])
}

model ConnectionGoal {
  id             String               @id @default(uuid())
  slug           String               @unique
  displayName    String
  normalizedName String               @unique
  isActive       Boolean              @default(true)
  sortOrder      Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  users          UserConnectionGoal[]

  @@index([isActive, sortOrder])
}

model UserConnectionGoal {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionGoalId String
  connectionGoal   ConnectionGoal @relation(fields: [connectionGoalId], references: [id], onDelete: Restrict)
  priority         Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([userId, connectionGoalId])
  @@index([connectionGoalId, userId])
}

model ProfileVisibilityRule {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  section   ProfileSection
  audience  ProfileAudience
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([userId, section])
  @@index([userId, audience])
}

model UserSetting {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileVisibility String   @default("PUBLIC")
  emailNotification Boolean  @default(true)
  language          String   @default("vi")
  theme             String   @default("light")
  travelStyles      String[] @default(["Backpack & Trek", "Foodie & Cafes"])
  updatedAt         DateTime @updatedAt
}

model LeadSubmission {
  id        String   @id @default(uuid())
  kind      String
  email     String
  name      String?
  phone     String?
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, email])
  @@index([createdAt])
}

model Payment {
  id                    String           @id @default(uuid())
  orderCode             Int              @unique
  userId                String
  user                  User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  planId                String
  plan                  Plan             @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscriptionId        String?
  subscription          Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  tier                  SubscriptionTier
  durationMonths        Int              @default(1)
  amount                Decimal          @db.Decimal(12, 2)
  currency              String           @default("VND")
  paymentMethod         String           @default("PAYOS")
  provider              PaymentProvider  @default(PAYOS)
  providerOrderId       String?
  providerTransactionId String?          @unique
  idempotencyKey        String?          @unique
  status                PaymentStatus    @default(PENDING)
  checkoutUrl           String?
  transactionRef        String?
  paidAt                DateTime?
  refundedAt            DateTime?
  rawWebhookData        Json?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  webhookEvents PaymentWebhookEvent[]

  @@unique([provider, providerOrderId])
  @@index([userId, status, createdAt])
  @@index([userId, status, orderCode])
  @@index([planId, status, createdAt])
}

model Plan {
  id            String           @id @default(uuid())
  code          String
  tier          SubscriptionTier
  displayName   String
  description   String?
  billingPeriod BillingPeriod
  price         Decimal          @db.Decimal(12, 2)
  currency      String           @default("VND")
  isActive      Boolean          @default(true)
  version       Int              @default(1)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  features      PlanFeature[]
  subscriptions Subscription[]
  payments      Payment[]

  @@unique([code, version])
  @@index([tier, isActive, version])
}

model Feature {
  id          String             @id @default(uuid())
  code        String             @unique
  displayName String
  description String?
  valueType   String             @default("BOOLEAN")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  plans       PlanFeature[]
  grants      EntitlementGrant[]
}

model PlanFeature {
  id         String   @id @default(uuid())
  planId     String
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureId  String
  feature    Feature  @relation(fields: [featureId], references: [id], onDelete: Restrict)
  enabled    Boolean  @default(false)
  limitValue Int?
  config     Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([planId, featureId])
  @@index([featureId, enabled])
}

model Subscription {
  id                 String             @id @default(uuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status             SubscriptionStatus @default(ACTIVE)
  source             SubscriptionSource
  startsAt           DateTime           @default(now())
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  payments           Payment[]

  @@index([userId, status, currentPeriodEnd])
  @@index([planId, status])
}

model EntitlementGrant {
  id         String                @id @default(uuid())
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  featureId  String
  feature    Feature               @relation(fields: [featureId], references: [id], onDelete: Restrict)
  sourceType EntitlementSourceType
  sourceId   String?
  value      Json?
  startsAt   DateTime              @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime              @default(now())

  @@index([userId, featureId, revokedAt, expiresAt])
  @@index([sourceType, sourceId])
}

model PaymentWebhookEvent {
  id               String                  @id @default(uuid())
  paymentId        String?
  payment          Payment?                @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  provider         PaymentProvider
  providerEventId  String
  payloadHash      String
  rawPayload       Json
  signatureValid   Boolean
  processingStatus WebhookProcessingStatus @default(RECEIVED)
  processedAt      DateTime?
  errorMessage     String?
  createdAt        DateTime                @default(now())

  @@unique([provider, providerEventId])
  @@index([processingStatus, createdAt])
  @@index([paymentId, createdAt])
}

model Post {
  id            String         @id @default(uuid())
  authorId      String
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  communityId   String?
  community     Community?     @relation(fields: [communityId], references: [id], onDelete: SetNull)
  content       String
  mediaUrls     String[]       @default([])
  visibility    PostVisibility @default(PUBLIC)
  audience      PostVisibility @default(PUBLIC)
  status        PostStatus     @default(PUBLISHED)
  previewText   String?
  commentPolicy CommentPolicy  @default(EVERYONE)
  likesCount    Int            @default(0)
  publishedAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  comments      Comment[]
  reports       Report[]
  media         PostMedia[]
  audienceUsers PostAudienceUser[]
  audienceLists PostAudienceList[]
  excludedUsers PostExcludedUser[]
  reactions     PostReaction[]
  bookmarks     PostBookmark[]
  shares        PostShare[]

  @@index([visibility, createdAt])
  @@index([status, audience, publishedAt, id])
  @@index([authorId, publishedAt, id])
  @@index([communityId, status, publishedAt, id])
}

model Comment {
  id              String        @id @default(uuid())
  postId          String
  post            Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId        String
  author          User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentCommentId String?
  parentComment   Comment?      @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[]     @relation("CommentReplies")
  content         String
  status          CommentStatus @default(APPROVED)
  moderationState String?
  flagReason      String?
  editedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  reports   Report[]
  reactions CommentReaction[]

  @@index([postId, status, createdAt])
  @@index([postId, parentCommentId, createdAt, id])
}

model MediaAsset {
  id                  String                @id @default(uuid())
  ownerId             String
  owner               User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  storageProvider     String
  bucket              String                @default("")
  objectKey           String
  sourceUrl           String?
  mimeType            String
  byteSize            BigInt?
  width               Int?
  height              Int?
  durationMs          Int?
  checksum            String?
  processingStatus    MediaProcessingStatus @default(UPLOADING)
  createdAt           DateTime              @default(now())
  deletedAt           DateTime?
  posts               PostMedia[]
  communityAvatars    Community[]           @relation("CommunityAvatar")
  communityCovers     Community[]           @relation("CommunityCover")
  conversationAvatars Conversation[]        @relation("ConversationAvatar")
  messageAttachments  MessageAttachment[]

  @@unique([storageProvider, bucket, objectKey])
  @@index([ownerId, processingStatus, createdAt])
}

model Community {
  id            String                 @id @default(uuid())
  ownerId       String
  owner         User                   @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
