PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL Connection String (Supabase / Neon / Local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/beebuddy?schema=public"

# Optional local database used to rehearse migrations before development.
STAGING_DATABASE_NAME=beebuddy_v2_staging

# JWT Authentication (use two different random values, at least 32 characters)
JWT_SECRET=beebuddy_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=beebuddy_refresh_secret_key_2026
JWT_REFRESH_EXPIRES_IN=7d

# Transactional email. "console" prints the code/link for local development only.
# Production requires EMAIL_DELIVERY_MODE=smtp and valid SMTP credentials.
EMAIL_DELIVERY_MODE=console
EMAIL_FROM="BeeBuddy <no-reply@beebuddy.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_VERIFICATION_TTL_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
AUTH_TOKEN_RESEND_COOLDOWN_SECONDS=60

# Encrypts push provider tokens at rest. Use a distinct random value (32+ chars).
PUSH_TOKEN_ENCRYPTION_KEY=beebuddy_local_push_token_key_change_me

# PayOS Payment Gateway Configuration (VietQR)
# Values beginning with mock_ are accepted only in local development.
# Production refuses to start until real PayOS credentials and HTTPS URLs are supplied.
PAYOS_CLIENT_ID=mock_client_id
PAYOS_API_KEY=mock_api_key
PAYOS_CHECKSUM_KEY=mock_checksum_key
PAYOS_RETURN_URL=http://localhost:3000/billing?status=success
PAYOS_CANCEL_URL=http://localhost:3000/billing?status=cancelled
